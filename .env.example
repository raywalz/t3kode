# Copy to .env (gitignored) and fill in.

# T3 Code server the bridge talks to.
T3_URL=http://127.0.0.1:3773

# Scoped bearer token. Mint one on the T3 host with:
#   t3 auth session issue --scope orchestration:read --scope orchestration:operate \
#       --label t3-koreader --ttl 30d --token-only
T3_TOKEN=

# Optional, for bridge/api_test.py: the project (id or title) to create the
# throwaway test thread in, and the model to use (instanceId/model).
# T3_TEST_PROJECT=
# T3_TEST_MODEL=<instanceId>/<model>
