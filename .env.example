# Copy to .env (gitignored) and fill in.

# ---- T3 Code server -----------------------------------------------------------
T3_URL=http://127.0.0.1:3773

# Scoped bearer token. Mint one on the T3 host with:
#   t3 auth session issue --scope orchestration:read --scope orchestration:operate \
#       --scope filesystem:read --label t3-koreader --ttl 30d --token-only
# (filesystem:read lets the bridge show images that replies point to; it's optional.)
T3_TOKEN=

# Optional: a command that prints a fresh token. With it, the bridge renews its token
# by itself a week before it expires (or as soon as T3 rejects it) and saves the new
# one above. Without it, the device shows a warning in the last week.
# T3_TOKEN_COMMAND="t3 auth session issue --scope orchestration:read --scope orchestration:operate --scope filesystem:read --label t3-koreader --ttl 30d --token-only"

# ---- Bridge (what the device talks to) ------------------------------------------
# Loopback by default. To reach it from the e-reader, bind to an address the device
# can reach (a LAN or VPN address), and then BRIDGE_TOKEN is required.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
# Shared secret the device sends. Behind a tunnel or reverse proxy, set it even though
# BRIDGE_HOST is loopback: the bridge can't tell it's reachable from outside. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
BRIDGE_TOKEN=

# Seconds between T3 polls: while something is running or a device is active, and otherwise.
# POLL_FAST=2
# POLL_SLOW=20

# ---- Suggested replies (optional) ---------------------------------------------
# Agents can write their own (see "replies" in docs/bridge-api.md); this model covers
# replies that don't. Any OpenAI-compatible endpoint (base URL ending in /v1). Leave
# SUGGEST_URL empty to use only the agents' own. A small, fast model is plenty.
SUGGEST_URL=
SUGGEST_API_KEY=
SUGGEST_MODEL=
# Sent as reasoning_effort. "none" keeps reasoning models from spending the token budget
# thinking. Set it empty if your endpoint rejects the field.
# SUGGEST_REASONING_EFFORT=none
# SUGGEST_COUNT=3

# ---- bridge/api_test.py only --------------------------------------------------
# T3_TEST_PROJECT=
# T3_TEST_MODEL=<instanceId>/<model>   (default: T3's default model for the project)
